<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AICrosswordGen.Views.OptionsWindow"
        Title="Options"
        Width="340" Height="240"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="10">
        <TextBlock Text="Puzzle Options" FontWeight="Bold"/>
        <TextBlock Text="Iterations"/>
        <NumericUpDown x:Name="IterationsBox" Minimum="1" Maximum="200" />
        <TextBlock Text="Seed"/>
        <NumericUpDown x:Name="SeedBox" Minimum="0" Maximum="99999"/>
        <CheckBox x:Name="FillerBox" Content="Use filler words (google-10000 3-7 letters)"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" x:Name="OkButton" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
