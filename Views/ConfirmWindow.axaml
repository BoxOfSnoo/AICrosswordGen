<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AICrosswordGen.Views.ConfirmWindow"
        Title="Confirm"
        Width="340" Height="160"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="10">
        <TextBlock x:Name="Msg" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Overwrite" Click="Ok_Click"/>
            <Button Content="Cancel" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
