<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AICrosswordGen.Views.AboutWindow"
        Title="About AICrosswordGen"
        Width="380" Height="280"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="8">
        <TextBlock Text="AICrosswordGen" FontWeight="Bold" FontSize="16"/>
        <TextBlock Text="Dense newspaper-style crossword generator." TextWrapping="Wrap"/>
        <TextBlock Text="Cross-platform Avalonia GUI. C# /.NET 10." TextWrapping="Wrap"/>
        <Button x:Name="RepoLink" Content="https://github.com/BoxOfSnoo/AICrosswordGen" Background="Transparent" Padding="0" VerticalAlignment="Center" Click="RepoLink_Click"/>
        <TextBlock Text="Jonathan Markevich &lt;jon@jonandtina.net&gt;" TextWrapping="Wrap"/>
        <Button Content="OK" HorizontalAlignment="Right" Click="Ok_Click"/>
    </StackPanel>
</Window>
